---
// import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import banner01 from '../assets/banner02.jpg';
---

<Layout>
	<section class='w-full aspect-6/2 relative'>
        <img src={banner01.src} alt="Proyectos" class='w-full h-full object-cover' />
		<div class='absolute top-0 left-0 w-full h-full bg-gradient-to-b from-black to-transparent'></div>
        <div class='absolute top-0 left-0 w-full h-full flex flex-col items-center justify-center'>
            <h1 class='text-4xl md:text-5xl font-bold text-white mb-4'>Proyectos</h1>
            <p class='text-white text-lg md:text-xl'>Explora nuestros proyectos y descubre cómo podemos transformar ideas en realidad.</p>
        </div>
	</section>

    <section class='w-full py-12 md:py-24'>
        <div class='w-full max-w-7xl mx-auto px-4'>
            <h2 class='text-2xl md:text-3xl font-bold text-white mb-4'>Nuestros proyectos</h2>

            <div class='grid grid-cols-12 gap-4'>
                <div class='col-span-12 md:col-span-6 lg:col-span-4'>
                    <div class='bg-white/10 backdrop-blur-sm p-4 rounded-lg border border-white/10 group hover:border-primary hover:shadow-lg transition-all duration-300'>
                        <div class='w-full aspect-5/6 relative overflow-hidden'>
                            <img src={banner01.src} alt="Proyecto 1" class='w-full h-full object-cover group-hover:scale-110 transition-all duration-300' />
                        </div>
                        <div class='py-4'>
                            <h3 class='text-lg md:text-xl font-bold text-white mb-2'>Proyecto 1</h3>
                            <p class='text-white/40 text-sm md:text-base mb-4'>Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quos.</p>
                            <a href="#" class='text-primary text-sm md:text-base'>Más detalles</a>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </section>
</Layout>
